@{
    Layout = "_LayoutDeslogada";
}
@if (TempData["MenssagemSucesso"] != null)
{
    <div class="alert alert-success text-light" role="alert">
        @TempData["MenssagemSucesso"]
    </div>
}
@if (TempData["ErroMenssagem"] != null)
{
    <div class="alert alert-success text-light" role="alert">
        @TempData["ErroMenssagem"]
    </div>
}
<div asp-validation-summary="All" class="text-danger"></div>

<div class="text-center">
    <h1>Empréstimo de livros online</h1>

    <p>"Ao ter acesso a novos livros, as pessoas podem ser incentivadas a ler, expandindo seu universo de conhecimento e lazer."</p>
    <div>
        <img src="/img/conhecimento.png" />
    </div>
</div>

